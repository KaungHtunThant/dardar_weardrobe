{
  "name": "dardar-wardrobe",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal wardrobe + AI style advisor (Electron + Nuxt)",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:web": "nuxt dev",
    "dev:mock": "NUXT_PUBLIC_GATEWAY=mock nuxt dev",
    "dev": "npm run build:electron && concurrently -k -n nuxt,electron \"nuxt dev\" \"wait-on -t 120000 http-get://localhost:3000 && electron .\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "nuxt build && node scripts/bundle-server-assets.mjs && npm run build:electron",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.electron.json",
    "lint": "eslint .",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "icon": "node scripts/generate-icon.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@iconify-json/lucide": "^1.2.148",
    "@imgly/background-removal-node": "^1.4.5",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.1",
    "@pinia/nuxt": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-vue": "^8.6.0",
    "embla-carousel-wheel-gestures": "^8.1.0",
    "idb": "^8.0.4",
    "nuxt": "^4.6.3",
    "ofetch": "^1.5.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@testing-library/vue": "^8.1.0",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.5.1"
  },
  "productName": "Dardar Wardrobe",
  "author": "Dardar",
  "desktopName": "dardar-wardrobe.desktop"
}
